# Copy this file to `.env.secrets` for local development.
# `.env.secrets` is intentionally gitignored.
# Never place real provider keys in `NEXT_PUBLIC_*` variables.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
INTERNAL_FUNCTION_SECRET=<long-random-secret>

# Supabase Auth Google provider credentials.
# In production these belong in the Supabase Dashboard Auth provider settings.
GOOGLE_OAUTH_CLIENT_ID=<google-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-client-secret>

# Read-only media search providers.
TMDB_API_KEY=<tmdb-api-key-or-read-token>
LASTFM_API_KEY=<lastfm-api-key>
MUSIC_SEARCH_PROVIDER=lastfm

# Moderation and enhancement providers.
MESSAGE_MODERATION_URL=<message-moderation-provider-url>
MESSAGE_MODERATION_API_KEY=<message-moderation-provider-key>
PHOTO_MODERATION_URL=<photo-moderation-provider-url>
PHOTO_MODERATION_API_KEY=<photo-moderation-provider-key>
AI_MESSAGE_ENHANCEMENT_URL=<ai-message-enhancement-provider-url>
AI_MESSAGE_ENHANCEMENT_API_KEY=<ai-message-enhancement-provider-key>

# Premium subscription provider placeholders.
PREMIUM_BILLING_PROVIDER=<razorpay-or-stripe-or-manual>
PREMIUM_BILLING_WEBHOOK_SECRET=<billing-webhook-secret>
PREMIUM_PRICE_INR_MONTHLY=299
