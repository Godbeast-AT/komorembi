NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Supabase Edge Function secrets. Configure these with `supabase secrets set`;
# do not expose them through NEXT_PUBLIC variables.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
INTERNAL_FUNCTION_SECRET=replace_with_a_long_random_secret
MESSAGE_MODERATION_URL=
MESSAGE_MODERATION_API_KEY=
PHOTO_MODERATION_URL=
PHOTO_MODERATION_API_KEY=

# Canvas 2 additions. Keep real values out of git; copy placeholders to
# `.env.secrets` or Supabase secrets when wiring providers.
TMDB_API_KEY=
LASTFM_API_KEY=
MUSIC_SEARCH_PROVIDER=lastfm
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AI_MESSAGE_ENHANCEMENT_URL=
AI_MESSAGE_ENHANCEMENT_API_KEY=
PREMIUM_BILLING_PROVIDER=
PREMIUM_BILLING_WEBHOOK_SECRET=
